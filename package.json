{
  "name": "pochade-update-test",
  "version": "1.0.0",
  "description": "Verify the GitHub release auto-update flow end to end",
  "main": "electron/main.js",
  "type": "module",
  "author": "LNSY",
  "license": "Unlicense",
  "keywords": [
    "electron",
    "sqlite",
    "node-sqlite",
    "node:sqlite",
    "database-sync",
    "file-system-access-api",
    "custom-elements",
    "vanilla-js",
    "dataroom-js",
    "webpack"
  ],
  "scripts": {
    "start": "webpack serve",
    "build": "NODE_ENV=production webpack build",
    "preelectron": "npm run build",
    "electron": "node electron/dev-runner.js",
    "electron:build": "npm run build && electron-builder",
    "test": "wdio run ./wdio.conf.js",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "dataroom-js": "^1.0.1",
    "dotenv": "17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@swc/core": "^1.9.3",
    "@wdio/cli": "^9.31.2",
    "@wdio/electron-service": "^10.2.0",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "copy-webpack-plugin": "^14.0.0",
    "cross-spawn": "^7.0.6",
    "css-loader": "^7.1.2",
    "cssnano": "^8.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "vitest": "^3.2.4",
    "webdriverio": "^9.31.2",
    "webpack": "^5.107.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  },
  "build": {
    "appId": "com.pochadeupdatetest.app",
    "productName": "Pochade Update Test",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "squirrel"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
